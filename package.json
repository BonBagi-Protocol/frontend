{
  "name": "bonbagi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One Zcash shielded payment, split to every member of a collective in one transaction.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && node scripts/prepare-deploy.mjs && vercel deploy dist --prod --yes"
  },
  "dependencies": {
    "@bonbagi/core": "github:BonBagi-Protocol/core#v0.1.0",
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/sofia-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/sofia-sans-extra-condensed": "^5.3.0",
    "@noble/ed25519": "2.3.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
